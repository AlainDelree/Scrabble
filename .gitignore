# Environnements virtuels
venv/
.venv/
.venv_build/

# Sorties de build / packaging (PyInstaller)
build/
dist/
*.spec
# Exception : le .spec de l'exécutable Windows (issue #154) est committé
# volontairement, contrairement aux artefacts *.spec habituels (temporaires).
!scrabble.spec

# Caches Python
__pycache__/
*.py[cod]

# Configuration locale auto-générée (recréée par scrabble.config)
config.json

# Dictionnaires tiers (ODS8, Hunspell fr-toutesvariantes) : déposés
# manuellement, jamais commités (licence floue). On garde uniquement le README.
data/dictionnaire/*
!data/dictionnaire/README.md

# Base SQLite des parties (persistance : historique + reprise) — jamais commitée
data/parties.db
data/*.db

# Journaux de diagnostic par session (scrabble.journal) — jamais commités
logs/

# Installeur Windows (Inno Setup, issue #217) : setup.exe générés jamais
# commités (volumineux, régénérables via installeur\scrabble.iss) — seul le
# script .iss et le README du dossier sont suivis. Voir installeur\README.md.
installeur/output/

# Outils de build locaux à la machine CCW (ex. Inno Setup portable) — jamais
# commités, jamais nécessaires ailleurs que sur la machine qui compile.
.tools/

# Sorties du script de mesure (scripts/mesurer_force_niveaux.py) — jamais
# commitées (produites localement à chaque exécution).
malus.csv
paliers_bas.csv
paliers_bas.log
avance_vs_champion.csv

# Divers
.pytest_cache/
tmp_diag_wiktionnaire/
avance_vs_champion.log

# Liste complémentaire locale et facultative de mots favoris du Lettré
# (issue #455) : mots ajoutés par Alain depuis une source qu'il ne veut pas
# publier dans le dépôt — jamais commitée, contrairement à
# data/personnages/lettre_mots_favoris.txt. Absente par défaut, sans effet
# sur le jeu (voir scrabble.moteur.personnages).
data/personnages/lettre_mots_meral.txt

# Liste de mots favoris de Titeuf (issue #452, lot J) : personnage
# désactivé, dépôt public — ce fichier de mots du dictionnaire en clair
# sort du suivi git (issue #487) mais reste sur le disque pour le jeu et
# les tests (chargement toujours tolérant à son absence, voir
# scrabble.moteur.personnages.charger_mots_favoris, même garantie que pour
# lettre_mots_meral.txt ci-dessus).
data/personnages/titeuf_mots_favoris.txt

# Captures et dossiers de sortie du harnais de vérification visuelle
# scripts/_harness_jeu/ (issue #487) : résultats ponctuels de vérifications
# passées (volumineux, régénérables en relançant le script concerné) —
# jamais commités désormais, sauf les deux captures encore citées dans
# CHANGELOG.md (issue #443).
scripts/_harness_jeu/*.png
!scripts/_harness_jeu/i443_accueil_personnages_1280x800.png
!scripts/_harness_jeu/i443_jeu_personnages_1280x800.png
scripts/_harness_jeu/verif_*_out/
